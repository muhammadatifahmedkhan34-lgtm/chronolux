## Local/demo SQLite (replace with Postgres in production)
DATABASE_URL="file:./dev.db"

## Auth
JWT_SECRET="change_this_to_a_strong_random_value"

## Resend (optional)
RESEND_API_KEY="your_resend_api_key"
RESEND_FROM_EMAIL="no-reply@chronolux.example"

## Cloudinary (optional)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_key"
CLOUDINARY_API_SECRET="your_cloudinary_secret"

## App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Never commit real secret values to the repository. Use your host's secret manager or environment configuration.
