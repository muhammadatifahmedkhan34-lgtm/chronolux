## Local/demo SQLite (replace with Postgres in production)
DATABASE_URL="file:./dev.db"

## Auth
JWT_SECRET="change_this_to_a_strong_random_value"

## Resend (optional)
## Email provider
# Choose provider: 'smtp' for Nodemailer SMTP (Gmail App Password), or 'resend' if using Resend service
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="yourgmail@gmail.com"
SMTP_PASS="your_google_app_password"
SMTP_FROM="ChronoLux <yourgmail@gmail.com>"
FORCE_EMAIL_SEND="true"

# If you still use Resend, optionally set these (not required for SMTP)
RESEND_API_KEY="your_resend_api_key"
RESEND_FROM_EMAIL="no-reply@chronolux.example"

## Cloudinary (optional)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_key"
CLOUDINARY_API_SECRET="your_cloudinary_secret"

## App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Never commit real secret values to the repository. Use your host's secret manager or environment configuration.
